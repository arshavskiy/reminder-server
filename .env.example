# Server port
PORT=3737

# MongoDB
MONGODB_URI=
MONGODB_DB=reminder-app

# Optional: override data directory (default: ./data)
DATA_DIR=

# AI backend
AI_BACKEND=openai
OPENAI_LOCAL_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OCR
OCR_LANGUAGE=heb+eng
AUTO_EXTRACT=true
EXTRACTION_MAX_CHARS=8000

# Google OAuth
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3737/auth/google/callback
ALLOWED_EMAILS=

# Session secret (use a long random string)
SESSION_SECRET=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_REJECT_UNAUTHORIZED=true
EMAIL_FROM=
EMAIL_FROM_NAME=ReminderOCR

# Reminders
REMINDER_ENABLED=true
REMINDER_ADVANCE_DAYS=30
REMINDER_CHECK_INTERVAL_MS=60000
TEST_EMAIL=
TEST_EMAIL_TEMPLATE_ID=

# Watch folder
WATCH_FOLDER_ENABLED=false
WATCH_FOLDER=

# Upload quota for role 'user' (pro and admin are unlimited)
USER_DOCUMENT_LIMIT=25

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=

# Optional S3-compatible object storage (Railway Buckets / DigitalOcean Spaces).
# Railway bucket variables can be added automatically with "Add to Service".
ENDPOINT=
REGION=auto
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=

# Optional aliases also supported.
BUCKET_ENDPOINT=
BUCKET_REGION=auto
BUCKET_NAME=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_FORCE_PATH_STYLE=false

# Legacy DigitalOcean Spaces variables are still supported.
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=fra1
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=
